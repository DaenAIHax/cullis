---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  category: string;
  updated?: string;
  currentSlug: string;
}

const { title, description, category, updated, currentSlug } = Astro.props;

const all = await getCollection('docs');
const sorted = all.sort((a, b) => a.data.order - b.data.order);

// group by category
const groups: Record<string, typeof sorted> = {};
for (const doc of sorted) {
  if (!groups[doc.data.category]) groups[doc.data.category] = [];
  groups[doc.data.category].push(doc);
}
const categoryOrder = ['Quickstart', 'Install', 'Enroll', 'Guides', 'Operate', 'Security', 'Reference'];
const orderedCategories = Object.keys(groups).sort(
  (a, b) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);

// Icon paths per category (stroke-based, minimal)
const categoryIcons: Record<string, string> = {
  Quickstart: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
  Install: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3',
  Enroll: 'M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4',
  Guides: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M16.24 7.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z',
  Operate: 'M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  Security: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  Reference: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
};
---

<Layout title={`${title} — Cullis docs`} description={description} theme="light">
  <section class="doc-shell">
    <div class="container wide">
      <aside class="doc-sidebar">
        <a href="/docs" class="sidebar-home">
          <span class="sh-label">Docs</span>
          <span class="sh-count">{all.length} articles</span>
        </a>
        {orderedCategories.map((cat) => (
          <div class="sidebar-group">
            <div class="sidebar-cat">
              <svg class="sidebar-cat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={categoryIcons[cat] || categoryIcons['Reference']} />
              </svg>
              <span>{cat}</span>
            </div>
            <ul>
              {groups[cat].map((doc) => (
                <li>
                  <a href={`/docs/${doc.id}`} class={doc.id === currentSlug ? 'is-active' : ''}>
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </aside>

      <main class="doc-main">
        <div class="doc-meta">
          <a href="/docs" class="dm-cat">{category}</a>
          {updated && <span class="dm-updated">updated {updated}</span>}
          <button type="button" class="dm-copy" data-copy-page aria-label="Copy page URL">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span>Copy page</span>
          </button>
        </div>

        <h1 class="doc-title">{title}</h1>
        {description && <p class="doc-description">{description}</p>}

        <article class="prose">
          <slot />
        </article>

        <footer class="doc-footer">
          <a href="/docs" class="back-link">← All docs</a>
        </footer>
      </main>
    </div>
  </section>
</Layout>

<style>
  .doc-shell {
    padding: clamp(6rem, 12vw, 9rem) 0 4rem;
  }

  .container.wide {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  /* Sidebar */
  .doc-sidebar {
    position: sticky;
    top: 6rem;
    padding: 1.5rem 0;
    border-right: 1px solid var(--border-subtle);
    padding-right: 1.5rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-medium) transparent;
  }

  .sidebar-home {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    border: none;
  }

  .sh-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .sh-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .sidebar-group {
    margin-bottom: 1.5rem;
  }

  .sidebar-cat {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.6rem;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .sidebar-cat-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: var(--text-secondary);
    opacity: 0.85;
  }

  .sidebar-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-group li {
    margin: 0;
  }

  .sidebar-group a {
    display: block;
    padding: 0.42rem 0.75rem 0.42rem 2rem;
    margin: 1px 0;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--text-secondary);
    text-decoration: none;
    border: none;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sidebar-group a:hover {
    color: var(--text-primary);
    background: rgba(10, 37, 64, 0.05);
  }

  .sidebar-group a.is-active {
    color: var(--text-primary);
    background: rgba(8, 145, 178, 0.10);
    font-weight: 600;
  }

  /* Main */
  .doc-main {
    min-width: 0;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .dm-cat {
    color: var(--accent-cyan);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--accent-cyan-dim);
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .dm-cat:hover {
    background: rgba(8, 145, 178, 0.08);
  }

  .dm-copy {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(10, 37, 64, 0.04);
  }

  .dm-copy svg {
    width: 13px;
    height: 13px;
  }

  .dm-copy:hover {
    color: var(--text-primary);
    border-color: rgba(8, 145, 178, 0.35);
    box-shadow:
      0 1px 2px rgba(10, 37, 64, 0.06),
      0 0 0 1px rgba(0, 229, 199, 0.12);
  }

  .dm-copy.copied {
    color: var(--accent-cyan);
    border-color: rgba(8, 145, 178, 0.5);
  }

  .doc-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .doc-description {
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 62ch;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Prose — Markdown rendering */
  .prose {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .prose :global(h1) {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.024em;
    color: var(--text-primary);
    margin: 3rem 0 1.25rem;
    line-height: 1.15;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 3rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-subtle);
    line-height: 1.2;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.018em;
    color: var(--text-primary);
    margin: 2rem 0 0.75rem;
    line-height: 1.3;
  }

  .prose :global(h4) {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    margin: 1.5rem 0 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1.2em;
    max-width: 68ch;
  }

  .prose :global(a) {
    color: var(--accent-cyan);
    border-bottom: 1px solid var(--accent-cyan-dim);
    transition: border-color 0.2s;
  }

  .prose :global(a:hover) {
    border-bottom-color: var(--accent-cyan);
  }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 500;
  }

  .prose :global(em) {
    color: var(--accent-cyan);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    background: rgba(10, 37, 64, 0.06);
    border-radius: 4px;
    color: var(--accent-cyan);
  }

  .prose :global(pre) {
    font-family: var(--font-mono);
    background: var(--bg-elevated);
    color: var(--text-primary);
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.84rem;
    line-height: 1.65;
    margin: 1.5rem 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.75rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .prose :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.6rem 1.5rem;
    border-left: 3px solid var(--accent-cyan);
    background: var(--bg-elevated);
    border-radius: 0 6px 6px 0;
    color: var(--text-secondary);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    text-align: left;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-medium);
    background: var(--bg-elevated);
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    vertical-align: top;
  }

  .prose :global(hr) {
    height: 1px;
    background: var(--border-subtle);
    border: none;
    margin: 2.5rem 0;
  }

  .prose :global(img) {
    max-width: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    margin: 1.25rem 0;
  }

  /* Footer */
  .doc-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-decoration: none;
    border: none;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent-cyan); }

  @media (max-width: 900px) {
    .container.wide {
      grid-template-columns: 1fr;
    }
    .doc-sidebar {
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding-right: 0;
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
      max-height: none;
    }
  }
</style>

<script>
  // Copy page URL to clipboard
  document.querySelectorAll('[data-copy-page]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const label = btn.querySelector('span');
        const original = label?.textContent ?? 'Copy page';
        btn.classList.add('copied');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = original;
        }, 1500);
      } catch (e) {
        console.warn('Clipboard write failed', e);
      }
    });
  });
</script>
