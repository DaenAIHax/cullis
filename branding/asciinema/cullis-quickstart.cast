{"version": 2, "width": 80, "height": 24, "timestamp": 1779790391, "env": {"SHELL": "/nix/store/nilkcchyj1l9ix3ww4p1fby7v00dwkpc-bash-interactive-5.3p3/bin/bash", "TERM": "xterm-ghostty"}}
[0.008007, "o", "\u001b[2m# Pull the v0.5.4 bundle from GitHub Releases\u001b[0m\r\n"]
[0.612702, "o", "\u001b[1;34m$\u001b[0m curl -L https://github.com/cullis-security/cullis/releases/download/mastio-v0.5.4/cullis-mastio-bundle.tar.gz | tar xz\r\n"]
[1.818895, "o", "cullis-mastio-bundle/\r\ncullis-mastio-bundle/deploy.sh\r\ncullis-mastio-bundle/docker-compose.yml\r\ncullis-mastio-bundle/nginx/\r\n... (24 files)\r\n"]
[2.221922, "o", "\u001b[2m# One command brings up Mastio: Org CA, admin DB, dashboard\u001b[0m\r\n"]
[2.82619, "o", "\u001b[1;34m$\u001b[0m cd cullis-mastio-bundle && ./deploy.sh\r\n"]
[4.034043, "o", "\u001b[1;32m✓\u001b[0m  Containers started\r\n\u001b[1;32m✓\u001b[0m  Mastio + nginx ready\r\n\u001b[1;32m✓\u001b[0m  Org CA exported (org_id=df2fd8d157224e59)\r\n\r\n  Dashboard: https://localhost:9443/proxy/login\r\n"]
[4.837723, "o", "\u001b[2m# Register the first admin (you'll do this in the browser; here via curl for the demo)\u001b[0m\r\n"]
[5.440611, "o", "\u001b[1;34m$\u001b[0m curl -k -X POST https://localhost:9443/proxy/register -d 'password=HnDemo2026!&confirm_password=HnDemo2026!'\r\n"]
[6.448159, "o", "← 303 → /proxy/login\r\n"]
[6.85099, "o", "\u001b[2m# Install the Python SDK\u001b[0m\r\n"]
[7.45533, "o", "\u001b[1;34m$\u001b[0m pip install cullis-sdk\r\n"]
[8.662853, "o", "Successfully installed cullis-sdk-0.1.3\r\n"]
[9.066247, "o", "\u001b[2m# Enroll an agent and chat — one factory call, three primitives applied\u001b[0m\r\n"]
[9.669898, "o", "\u001b[1;34m$\u001b[0m python agent.py\r\n"]
[10.577195, "o", "[sdk] discovered dpop.jwk sibling → loading DPoP key\r\n[sdk] Runtime client ready (mastio=https://localhost:9443, agent=df2fd8d157224e59::hn-demo-agent)\r\ncullis_trace_id: trace_a3f8c1d2…\r\nreply: 'OK'\r\nusage: {'prompt_tokens': 15, 'completion_tokens': 4, 'total_tokens': 19}\r\n"]
[11.781442, "o", "\u001b[2m# Every call carries a cryptographic identity. Every reply lands in an append-only audit chain.\u001b[0m\r\n"]
[12.385838, "o", "\r\n\u001b[1;32m→\u001b[0m x509 leaf cert signed by your Org CA\r\n\u001b[1;32m→\u001b[0m mTLS + DPoP (RFC 9449) on the wire, no shared API key\r\n"]
[12.385983, "o", "\u001b[1;32m→\u001b[0m Audit row hash-chained, RFC 3161 TSA-anchorable\r\n"]
[13.89012, "o", "\r\n\u001b[1;34mgithub.com/cullis-security/cullis\u001b[0m\r\n"]
